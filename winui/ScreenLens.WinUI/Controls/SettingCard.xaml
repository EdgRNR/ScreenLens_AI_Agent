<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ScreenLens.WinUI.Controls.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource SettingCardBorderStyle}" MinHeight="68">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Glyph="{x:Bind Icon, Mode=OneWay}"
                FontSize="18"
                Foreground="{ThemeResource AppTextSecondaryBrush}"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2"
                Margin="0,0,16,0">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CardTitleText}" TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind Description, Mode=OneWay}"
                    Style="{StaticResource CardDescText}"
                    Visibility="{x:Bind DescToVis(Description), Mode=OneWay}" />
            </StackPanel>

            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
