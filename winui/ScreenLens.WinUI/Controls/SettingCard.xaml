<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ScreenLens.WinUI.Controls.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="CardHost"
    mc:Ignorable="d">

    <Border x:Name="CardRoot" Style="{StaticResource SettingCardBorderStyle}" MinHeight="68">
        <!-- 窄窗口下操作控件移到标题下方，避免与说明文字互相挤压 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CardLayoutStates">
                <VisualState x:Name="WideCardState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionHost.(Grid.Row)" Value="0" />
                        <Setter Target="ActionHost.(Grid.Column)" Value="2" />
                        <Setter Target="ActionHost.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ActionHost.HorizontalAlignment" Value="Right" />
                        <Setter Target="ActionHost.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowCardState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionHost.(Grid.Row)" Value="1" />
                        <Setter Target="ActionHost.(Grid.Column)" Value="1" />
                        <Setter Target="ActionHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ActionHost.HorizontalAlignment" Value="Left" />
                        <Setter Target="ActionHost.Margin" Value="0,4,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel>
            <Grid x:Name="CardGrid" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MaxWidth="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <FontIcon
                    x:Name="CardIcon"
                    Grid.Row="0"
                    Grid.Column="0"
                    Glyph="{x:Bind Icon, Mode=OneWay}"
                    FontSize="18"
                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                    VerticalAlignment="Center" />

                <StackPanel
                    x:Name="CardText"
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CardTitleText}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind Description, Mode=OneWay}"
                        Style="{StaticResource CardDescText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind DescToVis(Description), Mode=OneWay}" />
                </StackPanel>

                <!-- 操作控件槽：绑定 ActionContent（ContentProperty 已重定向到该属性，
                     避免外部子元素覆盖 UserControl.Content 导致整张卡片被替换） -->
                <ContentPresenter
                    x:Name="ActionHost"
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Content="{x:Bind ActionContent, Mode=OneWay}" />
            </Grid>
            <ContentPresenter Margin="34,12,0,0"
                              HorizontalContentAlignment="Stretch"
                              Content="{x:Bind DetailsContent, Mode=OneWay}"
                              Visibility="{x:Bind DetailsToVis(DetailsContent), Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
