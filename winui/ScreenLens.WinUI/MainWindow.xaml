<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenLens.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ScreenLens.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ScreenLens 设置">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- 设置页内容区宽度上限：保证各页卡片等宽且左对齐 -->
            <conv:WidthClampConverter x:Key="ClampContentWidth" MaxWidth="1000" />
        </Grid.Resources>

        <!-- 自定义沉浸式标题栏：品牌区与侧栏同色，右侧与页面同色；系统标题文字不再单独占一条原生黑栏。 -->
        <Grid x:Name="CustomTitleBar" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource AppWindowBgBrush}">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,12,0" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/BrandLogo.png" Width="28" Height="28" />
                    <TextBlock Text="ScreenLens 设置"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource AppWindowBgBrush}" />
        </Grid>

        <!-- 导航始终占满客户区：通知以覆盖层显示，不推移布局 -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            OpenPaneLength="212"
            SelectionChanged="OnNavSelectionChanged"
            Background="Transparent"
            Foreground="{ThemeResource AppTextPrimaryBrush}">

            <NavigationView.Resources>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                </Style>
                <Style TargetType="FontIcon">
                    <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                </Style>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="通用" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="截图与选区" Tag="Capture">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="OCR 与结果" Tag="Ocr">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="翻译" Tag="Translate">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="快捷键" Tag="Hotkeys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观" Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="打开截图选区演示" Tag="CaptureDemo">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 右侧内容区：实色表面，可滚动。
                 Frame 宽度钳制到 1000 DIP 并左对齐，使七个设置页的卡片宽度一致。 -->
            <Grid Background="{ThemeResource AppWindowBgBrush}">
                <ScrollViewer x:Name="ContentScroll" HorizontalScrollMode="Disabled">
                    <Frame
                        x:Name="ContentFrame"
                        HorizontalAlignment="Left"
                        Width="{Binding ViewportWidth, ElementName=ContentScroll, Converter={StaticResource ClampContentWidth}}" />
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- 通知浮层：与主内容共用单元格的覆盖层，右上显示，
             出现/关闭不改变任何页面元素的测量尺寸 -->
        <InfoBar
            x:Name="ToastBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational"
            Title="原型演示"
            Message="尚未接入功能"
            MaxWidth="420"
            Margin="16,12,16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsTabStop="False" />
    </Grid>
</Window>
