<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenLens.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ScreenLens 设置">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <!-- 导航始终占满客户区：通知以覆盖层显示，不推移布局 -->
        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="212"
            SelectionChanged="OnNavSelectionChanged"
            Background="Transparent">

            <NavigationView.PaneHeader>
                <!-- 品牌区域：正式 Logo -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,16,16,12">
                    <Image
                        Source="Assets/BrandLogo.png"
                        Width="28" Height="28"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="ScreenLens"
                        FontWeight="SemiBold"
                        FontSize="15"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="通用" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="截图与选区" Tag="Capture">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="OCR 与结果" Tag="Ocr">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="翻译" Tag="Translate">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="快捷键" Tag="Hotkeys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观" Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="打开截图选区演示" Tag="CaptureDemo">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 右侧内容区：实色表面，可滚动 -->
            <Grid Background="{ThemeResource AppWindowBgBrush}">
                <ScrollViewer>
                    <Frame x:Name="ContentFrame" />
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- 通知浮层：与主内容共用单元格的覆盖层，右上显示，
             出现/关闭不改变任何页面元素的测量尺寸 -->
        <InfoBar
            x:Name="ToastBar"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational"
            Title="原型演示"
            Message="尚未接入功能"
            MaxWidth="420"
            Margin="16,12,16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsTabStop="False" />
    </Grid>
</Window>
