<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenLens.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ScreenLens 设置">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部轻量演示提示（对尚未实现的操作统一反馈） -->
        <InfoBar
            Grid.Row="0"
            x:Name="ToastBar"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational"
            Title="原型演示"
            Message="尚未接入功能"
            Margin="16,8,16,0"
            HorizontalAlignment="Right" />

        <NavigationView
            Grid.Row="1"
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="212"
            SelectionChanged="OnNavSelectionChanged"
            Background="Transparent">

            <NavigationView.PaneHeader>
                <!-- 品牌区域：ScreenLens 自己的标识 -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,16,16,12">
                    <Border
                        Width="28" Height="28"
                        CornerRadius="6"
                        Background="{ThemeResource ScreenLensAccentBrush}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="White" />
                    </Border>
                    <TextBlock
                        Text="ScreenLens"
                        FontWeight="SemiBold"
                        FontSize="15"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="通用" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="截图与选区" Tag="Capture">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="OCR 与结果" Tag="Ocr">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="翻译" Tag="Translate">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="快捷键" Tag="Hotkeys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观" Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="打开截图选区演示" Tag="CaptureDemo">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 右侧内容区：实色表面，可滚动 -->
            <Grid Background="{ThemeResource AppWindowBgBrush}">
                <ScrollViewer>
                    <Frame x:Name="ContentFrame" />
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
