<?xml version="1.0" encoding="utf-8"?>
<!--
  ScreenLens WinUI 主题资源
  - 深色为默认基线；Light/Dark 双 ThemeDictionaries 支持即时切换
  - 8px 间距节奏；卡片比内容区亮一档；ScreenLens 蓝作为强调色
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- Keep brushes self-contained: StaticResource color aliases can retain
                 the application startup palette when a window changes RequestedTheme. -->
            <SolidColorBrush x:Key="AppWindowBgBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="AppNavBgBrush" Color="#ECECEC" />
            <SolidColorBrush x:Key="AppCardBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E4E4E4" />
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#5F5F5F" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#8A8A8A" />
            <!-- NavigationView selection states bypass the item's Foreground. -->
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#1A1A1A" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#1A1A1A" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#5F5F5F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#E4E4E4" />
            <SolidColorBrush x:Key="AppBadgeBgBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="AppBadgeFgBrush" Color="#FFFFFF" />

            <!-- Screenshot toolbar surfaces and labels follow the window theme. -->
            <SolidColorBrush x:Key="CaptureToolbarBgBrush" Color="#F4F5F7" />
            <SolidColorBrush x:Key="CaptureToolbarHandleBgBrush" Color="#E7E9ED" />
            <SolidColorBrush x:Key="CaptureToolbarHandleFgBrush" Color="#555B64" />
            <SolidColorBrush x:Key="CaptureToolbarPrimaryBrush" Color="#202124" />
            <SolidColorBrush x:Key="CaptureToolbarSecondaryBrush" Color="#737780" />

            <!-- 截图选区使用固定的 ScreenLens 蓝。 -->
            <SolidColorBrush x:Key="ScreenLensAccentBrush" Color="#3D9BFF" />

            <!-- 禁用的 ToggleSwitch 仍保留可辨识的轨道，避免浅色卡片上只剩灰色圆点。 -->
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#F4F4F4" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#858585" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#858585" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Keep brushes self-contained: StaticResource color aliases can retain
                 the application startup palette when a window changes RequestedTheme. -->
            <SolidColorBrush x:Key="AppWindowBgBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AppNavBgBrush" Color="#191919" />
            <SolidColorBrush x:Key="AppCardBgBrush" Color="#282828" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#373737" />
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="#2F2F2F" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#A6A6A6" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#7A7A7A" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F2F2F2" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#F2F2F2" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#A6A6A6" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedDisabled" Color="#7A7A7A" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#333333" />
            <SolidColorBrush x:Key="AppBadgeBgBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="AppBadgeFgBrush" Color="#FFFFFF" />

            <!-- Screenshot toolbar surfaces and labels follow the window theme. -->
            <SolidColorBrush x:Key="CaptureToolbarBgBrush" Color="#282828" />
            <SolidColorBrush x:Key="CaptureToolbarHandleBgBrush" Color="#373737" />
            <SolidColorBrush x:Key="CaptureToolbarHandleFgBrush" Color="#C5CAD3" />
            <SolidColorBrush x:Key="CaptureToolbarPrimaryBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="CaptureToolbarSecondaryBrush" Color="#A6A6A6" />

            <!-- 截图选区使用固定的 ScreenLens 蓝。 -->
            <SolidColorBrush x:Key="ScreenLensAccentBrush" Color="#3D9BFF" />

            <!-- 深色禁用态同样保留轨道轮廓，但与可交互开关保持明显区分。 -->
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#292929" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#737373" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#737373" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- 字号阶梯 -->
    <x:Double x:Key="TextSizePageTitle">28</x:Double>
    <x:Double x:Key="TextSizeSectionHeader">15</x:Double>
    <x:Double x:Key="TextSizeBody">14</x:Double>
    <x:Double x:Key="TextSizeSecondary">12</x:Double>
    <x:Double x:Key="TextSizeBadge">12</x:Double>

    <!-- 8px 间距节奏 -->
    <!-- 内容标题与侧栏第一项顶部对齐，保留左右与底部留白。 -->
    <Thickness x:Key="PagePadding">32,0,32,32</Thickness>
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">16</x:Double>
    <x:Double x:Key="SpaceL">24</x:Double>

    <!-- 设置页统一内容布局：左对齐 + 统一最大宽度（所有页面共享同一基线） -->
    <!--
        设置页统一内容容器：撑满承载它的 Frame（Frame 已按窗口宽度钳制到 1000 DIP
        并左对齐），这样各页卡片宽度一致、左边缘基线统一。
        注意不要在这里设 HorizontalAlignment="Left"，否则 StackPanel 宽度会退化为
        内容自然宽度，导致不同页面卡片宽窄不一。
    -->
    <Style x:Key="SettingsPagePanel" TargetType="StackPanel">
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="MaxWidth" Value="1000" />
    </Style>

    <!-- 卡片圆角 -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <!-- 设置卡片边框样式 -->
    <Style x:Key="SettingCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- 文本样式 -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizePageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeSectionHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>

    <Style x:Key="CardDescText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeSecondary}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DemoNoteText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeSecondary}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 等宽示例文本（识别原文） -->
    <Style x:Key="SampleMonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

</ResourceDictionary>
