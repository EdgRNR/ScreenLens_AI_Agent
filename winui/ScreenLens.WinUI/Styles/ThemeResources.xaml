<?xml version="1.0" encoding="utf-8"?>
<!--
  ScreenLens WinUI 主题资源
  - 深色为默认基线；Light/Dark 双 ThemeDictionaries 支持即时切换
  - 8px 间距节奏；卡片比内容区亮一档；ScreenLens 蓝作为强调色
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppWindowBgColor">#F3F3F3</Color>
            <Color x:Key="AppNavBgColor">#ECECEC</Color>
            <Color x:Key="AppCardBgColor">#FFFFFF</Color>
            <Color x:Key="AppCardBorderColor">#E4E4E4</Color>
            <Color x:Key="AppCardHoverColor">#F7F7F7</Color>
            <Color x:Key="AppTextPrimaryColor">#1A1A1A</Color>
            <Color x:Key="AppTextSecondaryColor">#5F5F5F</Color>
            <Color x:Key="AppTextTertiaryColor">#8A8A8A</Color>
            <Color x:Key="AppDividerColor">#E4E4E4</Color>
            <Color x:Key="AppMaskColor">#66000000</Color>
            <Color x:Key="AppBadgeBgColor">#2B2B2B</Color>
            <Color x:Key="AppBadgeFgColor">#FFFFFF</Color>

            <SolidColorBrush x:Key="AppWindowBgBrush" Color="{StaticResource AppWindowBgColor}" />
            <SolidColorBrush x:Key="AppNavBgBrush" Color="{StaticResource AppNavBgColor}" />
            <SolidColorBrush x:Key="AppCardBgBrush" Color="{StaticResource AppCardBgColor}" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="{StaticResource AppCardBorderColor}" />
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="{StaticResource AppCardHoverColor}" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{StaticResource AppTextTertiaryColor}" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="{StaticResource AppDividerColor}" />
            <SolidColorBrush x:Key="AppMaskBrush" Color="{StaticResource AppMaskColor}" />
            <SolidColorBrush x:Key="AppBadgeBgBrush" Color="{StaticResource AppBadgeBgColor}" />
            <SolidColorBrush x:Key="AppBadgeFgBrush" Color="{StaticResource AppBadgeFgColor}" />

            <!-- ScreenLens 强调色（运行时可由 App.ApplyAccent 替换） -->
            <SolidColorBrush x:Key="ScreenLensAccentBrush" Color="#3D9BFF" />
            <SolidColorBrush x:Key="ScreenLensAccentHoverBrush" Color="#5CA8FF" />
            <SolidColorBrush x:Key="ScreenLensAccentPressedBrush" Color="#2B7FE0" />

            <!-- 禁用的 ToggleSwitch 仍保留可辨识的轨道，避免浅色卡片上只剩灰色圆点。 -->
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#F4F4F4" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#858585" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#858585" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppWindowBgColor">#1F1F1F</Color>
            <Color x:Key="AppNavBgColor">#191919</Color>
            <Color x:Key="AppCardBgColor">#282828</Color>
            <Color x:Key="AppCardBorderColor">#373737</Color>
            <Color x:Key="AppCardHoverColor">#2F2F2F</Color>
            <Color x:Key="AppTextPrimaryColor">#F2F2F2</Color>
            <Color x:Key="AppTextSecondaryColor">#A6A6A6</Color>
            <Color x:Key="AppTextTertiaryColor">#7A7A7A</Color>
            <Color x:Key="AppDividerColor">#333333</Color>
            <Color x:Key="AppMaskColor">#88000000</Color>
            <Color x:Key="AppBadgeBgColor">#2B2B2B</Color>
            <Color x:Key="AppBadgeFgColor">#FFFFFF</Color>

            <SolidColorBrush x:Key="AppWindowBgBrush" Color="{StaticResource AppWindowBgColor}" />
            <SolidColorBrush x:Key="AppNavBgBrush" Color="{StaticResource AppNavBgColor}" />
            <SolidColorBrush x:Key="AppCardBgBrush" Color="{StaticResource AppCardBgColor}" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="{StaticResource AppCardBorderColor}" />
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="{StaticResource AppCardHoverColor}" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{StaticResource AppTextTertiaryColor}" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="{StaticResource AppDividerColor}" />
            <SolidColorBrush x:Key="AppMaskBrush" Color="{StaticResource AppMaskColor}" />
            <SolidColorBrush x:Key="AppBadgeBgBrush" Color="{StaticResource AppBadgeBgColor}" />
            <SolidColorBrush x:Key="AppBadgeFgBrush" Color="{StaticResource AppBadgeFgColor}" />

            <!-- ScreenLens 强调色（运行时可由 App.ApplyAccent 替换） -->
            <SolidColorBrush x:Key="ScreenLensAccentBrush" Color="#3D9BFF" />
            <SolidColorBrush x:Key="ScreenLensAccentHoverBrush" Color="#5CA8FF" />
            <SolidColorBrush x:Key="ScreenLensAccentPressedBrush" Color="#2B7FE0" />

            <!-- 深色禁用态同样保留轨道轮廓，但与可交互开关保持明显区分。 -->
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#292929" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#737373" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#737373" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- 预设强调色（外观页演示） -->
    <SolidColorBrush x:Key="AccentOption1Brush" Color="#3D9BFF" />
    <SolidColorBrush x:Key="AccentOption2Brush" Color="#7C6FF0" />
    <SolidColorBrush x:Key="AccentOption3Brush" Color="#4CC38A" />
    <SolidColorBrush x:Key="AccentOption4Brush" Color="#E5602F" />

    <!-- 字号阶梯 -->
    <x:Double x:Key="TextSizePageTitle">28</x:Double>
    <x:Double x:Key="TextSizeSectionHeader">15</x:Double>
    <x:Double x:Key="TextSizeBody">14</x:Double>
    <x:Double x:Key="TextSizeSecondary">12</x:Double>
    <x:Double x:Key="TextSizeBadge">12</x:Double>

    <!-- 8px 间距节奏 -->
    <!-- 内容标题与侧栏第一项顶部对齐，保留左右与底部留白。 -->
    <Thickness x:Key="PagePadding">32,0,32,32</Thickness>
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">16</x:Double>
    <x:Double x:Key="SpaceL">24</x:Double>

    <!-- 设置页统一内容布局：左对齐 + 统一最大宽度（所有页面共享同一基线） -->
    <!--
        设置页统一内容容器：撑满承载它的 Frame（Frame 已按窗口宽度钳制到 1000 DIP
        并左对齐），这样各页卡片宽度一致、左边缘基线统一。
        注意不要在这里设 HorizontalAlignment="Left"，否则 StackPanel 宽度会退化为
        内容自然宽度，导致不同页面卡片宽窄不一。
    -->
    <Style x:Key="SettingsPagePanel" TargetType="StackPanel">
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="MaxWidth" Value="1000" />
    </Style>

    <!-- 卡片圆角 -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <!-- 设置卡片边框样式 -->
    <Style x:Key="SettingCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- 文本样式 -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizePageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeSectionHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>

    <Style x:Key="CardDescText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeSecondary}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DemoNoteText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSizeSecondary}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 等宽示例文本（识别原文） -->
    <Style x:Key="SampleMonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <!-- 演示窗口的选区边框（强调色运行时可变） -->
    <Style x:Key="SelectionBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource ScreenLensAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ScreenLens 主按钮：跟随强调色（用于确认、翻译、打开演示等主操作） -->
    <Style x:Key="AppAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ScreenLensAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

</ResourceDictionary>
