<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenLens.WinUI.Views.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenLens.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Style="{StaticResource SettingsPagePanel}">

        <TextBlock Text="通用" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="应用的基础行为设置（原型演示，更改仅保存在内存中）" Style="{StaticResource PageSubtitleText}" />

        <TextBlock Text="主题" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE790;" Title="主题模式" Description="选择应用外观，切换后立即在当前窗口预览">
            <ComboBox SelectedIndex="{x:Bind Vm.ThemeMode, Mode=TwoWay}" MinWidth="160">
                <ComboBoxItem Content="跟随系统" />
                <ComboBoxItem Content="浅色" />
                <ComboBoxItem Content="深色" />
            </ComboBox>
        </controls:SettingCard>

        <TextBlock Text="启动" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE7E8;" Title="开机自动启动" Description="登录 Windows 后自动运行 ScreenLens（原型演示：不修改系统启动项）">
            <ToggleSwitch IsOn="{x:Bind Vm.LaunchAtStartup, Mode=TwoWay}" OnContent="" OffContent="" />
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE923;" Title="启动后最小化" Description="仅保留托盘图标，不显示主窗口（原型演示：仅内存状态）" IsEnabled="{x:Bind Vm.LaunchAtStartup, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind Vm.StartMinimized, Mode=TwoWay}" OnContent="" OffContent="" />
        </controls:SettingCard>

        <TextBlock Text="语言" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xF2B7;" Title="界面语言" Description="当前版本暂仅提供简体中文">
            <Button Content="了解可用语言" Click="OnPendingClick" />
        </controls:SettingCard>

        <TextBlock Text="&#xE946; 原型提示：本页开关均为演示状态，不会写入系统或配置文件。"
                   Style="{StaticResource DemoNoteText}" Margin="0,12,0,0" />

    </StackPanel>
</Page>
