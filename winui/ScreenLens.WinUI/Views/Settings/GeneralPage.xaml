<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenLens.WinUI.Views.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenLens.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <StackPanel Style="{StaticResource SettingsPagePanel}">

        <TextBlock Text="通用" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="应用的基础行为设置（主题为前端偏好，其他开关项暂未提供实际效果）" Style="{StaticResource PageSubtitleText}" />

        <TextBlock Text="主题" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE790;" Title="主题模式" Description="选择应用外观，切换后立即在当前窗口预览">
            <ComboBox SelectedIndex="{x:Bind Vm.ThemeMode, Mode=TwoWay}" MinWidth="160">
                <ComboBoxItem Content="跟随系统" />
                <ComboBoxItem Content="浅色" />
                <ComboBoxItem Content="深色" />
            </ComboBox>
        </controls:SettingCard>

        <TextBlock Text="启动" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE7E8;" Title="开机自动启动" Description="登录 Windows 后自动运行 ScreenLens（当前版本未实现，仅作入口）" IsEnabled="False">
            <ToggleSwitch IsOn="{x:Bind Vm.LaunchAtStartup, Mode=TwoWay}" OnContent="" OffContent="" />
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE923;" Title="启动后最小化" Description="仅保留托盘图标，不显示主窗口（需先开启上方的开机自动启动，当前版本未实现）" IsEnabled="False">
            <ToggleSwitch IsOn="{x:Bind Vm.StartMinimized, Mode=TwoWay}"
                          OnContent="" OffContent="" />
        </controls:SettingCard>

        <TextBlock Text="语言" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xF2B7;" Title="界面语言" Description="当前版本暂仅提供简体中文">
            <Button Content="了解可用语言" Click="OnPendingClick" />
        </controls:SettingCard>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AppTextTertiaryBrush}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="提示：「开机自动启动 / 启动后最小化」当前版本未提供实际能力，仅保留控件以展示后续版本规划。"
                       Style="{StaticResource DemoNoteText}" Margin="6,0,0,0" TextWrapping="Wrap" />
        </Grid>

    </StackPanel>
</Page>
