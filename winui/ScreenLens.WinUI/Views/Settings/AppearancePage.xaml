<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenLens.WinUI.Views.Settings.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenLens.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Style="{StaticResource SettingsPagePanel}">

        <TextBlock Text="外观" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="设置主题与界面密度" Style="{StaticResource PageSubtitleText}" />

        <TextBlock Text="主题" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE790;" Title="主题模式" Description="与「通用」页设置联动">
            <ComboBox SelectedIndex="{x:Bind Vm.ThemeMode, Mode=TwoWay}" MinWidth="160">
                <ComboBoxItem Content="跟随系统" />
                <ComboBoxItem Content="浅色" />
                <ComboBoxItem Content="深色" />
            </ComboBox>
        </controls:SettingCard>

        <TextBlock Text="密度" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE71C;" Title="卡片密度" Description="切换后立即改变所有设置页卡片的内边距与高度">
            <ComboBox SelectedIndex="{x:Bind Vm.CardDensity, Mode=TwoWay}" MinWidth="140">
                <ComboBoxItem Content="舒适" />
                <ComboBoxItem Content="紧凑" />
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE8D9;" Title="界面字号" Description="跟随系统缩放设置，暂不提供独立选项">
            <Button Content="了解系统缩放" Click="OnPendingClick" />
        </controls:SettingCard>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AppTextTertiaryBrush}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="主题与卡片密度会自动保存，下次启动继续使用。"
                       Style="{StaticResource DemoNoteText}" Margin="6,0,0,0" />
        </Grid>

    </StackPanel>
</Page>
