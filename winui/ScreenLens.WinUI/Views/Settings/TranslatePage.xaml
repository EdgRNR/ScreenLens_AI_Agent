<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenLens.WinUI.Views.Settings.TranslatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenLens.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <StackPanel Style="{StaticResource SettingsPagePanel}">

        <TextBlock Text="翻译" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="截图识别文本的翻译服务（设置经命名管道与后台代理同步，保存到本机配置）" Style="{StaticResource PageSubtitleText}" />

        <TextBlock Text="目标语言" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE774;" Title="翻译目标语言" Description="识别文本将被翻译为该语言">
            <ComboBox SelectedIndex="{x:Bind Vm.TargetLanguage, Mode=TwoWay}" MinWidth="160">
                <ComboBoxItem Content="简体中文" />
                <ComboBoxItem Content="英语" />
                <ComboBoxItem Content="日语" />
            </ComboBox>
        </controls:SettingCard>

        <TextBlock Text="服务商" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE703;" Title="翻译服务" Description="Google 免费无需 API Key；OpenAI 兼容支持多家服务商；关闭后截图仅识别不翻译">
            <ComboBox SelectedIndex="{x:Bind Vm.Provider, Mode=TwoWay}" MinWidth="180">
                <ComboBoxItem Content="Google 免费" />
                <ComboBoxItem Content="OpenAI 兼容" />
                <ComboBoxItem Content="关闭翻译" />
            </ComboBox>
        </controls:SettingCard>

        <!-- 连接参数：仅 OpenAI 兼容时显示 -->
        <Border Style="{StaticResource SettingCardBorderStyle}" Padding="16"
                Visibility="{x:Bind ProviderFormVis(Vm.Provider), Mode=OneWay}">
            <Grid RowSpacing="12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="480" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="2" Text="连接参数（API Key 仅写入本地配置，绝不出现在日志或界面提示中）" Style="{StaticResource CardTitleText}" />

                <TextBlock Grid.Row="1" Text="API 地址" Style="{StaticResource CardDescText}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         PlaceholderText="https://api.openai.com/v1"
                         Text="{x:Bind Vm.OpenAiBaseUrl, Mode=TwoWay}"
                         HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="2" Text="模型" Style="{StaticResource CardDescText}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" PlaceholderText="gpt-4o-mini"
                         Text="{x:Bind Vm.OpenAiModel, Mode=TwoWay}"
                         HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="3" Text="API 密钥" Style="{StaticResource CardDescText}" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="3" Grid.Column="1" PlaceholderText="sk-••••••••••••••••••••"
                             Password="{x:Bind Vm.OpenAiApiKey, Mode=TwoWay}"
                             HorizontalAlignment="Stretch" PasswordRevealMode="Peek" />
            </Grid>
        </Border>

        <!-- 关闭翻译说明 -->
        <Border Style="{StaticResource SettingCardBorderStyle}" Padding="16"
                Visibility="{x:Bind ProviderOffVis(Vm.Provider), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE7E7;" FontSize="16" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                <TextBlock Style="{StaticResource CardDescText}" VerticalAlignment="Center"
                           Text="翻译已关闭：截图仅识别文字，不进行翻译。" />
            </StackPanel>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AppTextTertiaryBrush}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="隐私说明：翻译时仅发送选区内识别到的文本，截图本身不会上传；API Key 仅保存在本机配置文件中。"
                       Style="{StaticResource DemoNoteText}" Margin="6,0,0,0" TextWrapping="Wrap" />
        </Grid>

    </StackPanel>
</Page>
