<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenLens.WinUI.Views.Settings.OcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenLens.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Style="{StaticResource SettingsPagePanel}">

        <TextBlock Text="OCR 与结果" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="识别结果面板的展示方式（原型演示）" Style="{StaticResource PageSubtitleText}" />

        <TextBlock Text="结果面板" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE707;" Title="面板出现位置" Description="识别完成后结果窗口的显示位置">
            <ComboBox SelectedIndex="{x:Bind Vm.ResultPosition, Mode=TwoWay}" MinWidth="200">
                <ComboBoxItem Content="跟随截图位置" />
                <ComboBoxItem Content="屏幕居中" />
                <ComboBoxItem Content="记住上次位置" />
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE8E9;" Title="原文字号" Description="结果面板中识别原文的字号">
            <ComboBox SelectedIndex="{x:Bind Vm.OriginalFontSize, Mode=TwoWay}" MinWidth="120">
                <ComboBoxItem Content="小" />
                <ComboBoxItem Content="中" />
                <ComboBoxItem Content="大" />
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE8C8;" Title="复制按钮外观" Description="结果面板上复制按钮的显示形式">
            <ComboBox SelectedIndex="{x:Bind Vm.CopyButtonLook, Mode=TwoWay}" MinWidth="160">
                <ComboBoxItem Content="图标 + 文字" />
                <ComboBoxItem Content="仅图标" />
            </ComboBox>
        </controls:SettingCard>

        <TextBlock Text="复制按钮外观预览" Style="{StaticResource SectionHeaderText}" />
        <Border Style="{StaticResource SettingCardBorderStyle}" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <!-- 图标 + 文字 -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="复制" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="图标 + 文字" Style="{StaticResource DemoNoteText}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 仅图标 -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button>
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                    <TextBlock Text="仅图标" Style="{StaticResource DemoNoteText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="示例识别文本" Style="{StaticResource SectionHeaderText}" />
        <Border Style="{StaticResource SettingCardBorderStyle}" Padding="16">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Success" Title="识别完成" Message="识别到 3 行文本" />
                </StackPanel>
                <TextBlock Style="{StaticResource SampleMonoText}" xml:space="preserve">ScreenLens —— 屏幕翻译小工具
快捷键：Ctrl + Alt + A 启动截图翻译
Esc 取消本次截图</TextBlock>
                <TextBlock Text="以上为静态示例，不代表真实识别结果。" Style="{StaticResource DemoNoteText}" />
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
