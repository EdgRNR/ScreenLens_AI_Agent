<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenLens.WinUI.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenLens.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Style="{StaticResource SettingsPagePanel}">

        <TextBlock Text="关于" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="关于 ScreenLens 的信息" Style="{StaticResource PageSubtitleText}" />

        <!-- 品牌区：Logo + 产品名 + 副标题，按页面内容左侧基线对齐（不居中悬浮）。
             注意：Page 内的资源相对 URI 会以 Page 所在目录为基准解析，
             必须使用 ms-appx 绝对 URI，否则 "Assets/BrandLogo.png" 会指向
             Views/Settings/Assets/… 而加载失败。 -->
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,20">
            <Image
                Source="ms-appx:///Assets/BrandLogo.png"
                Width="56"
                Height="56"
                VerticalAlignment="Top" />
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="ScreenLens" FontSize="22" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                <TextBlock Text="屏幕文字识别与翻译工具 · WinUI 前端" Style="{StaticResource CardDescText}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="运行状态" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE9D9;" Title="后台代理"
                              Description="{x:Bind Vm.BackendStatus, Mode=OneWay}">
            <Border VerticalAlignment="Center">
                <TextBlock FontSize="13" FontFamily="Consolas"
                           Text="{x:Bind Vm.BackendStatus, Mode=OneWay}" />
            </Border>
        </controls:SettingCard>

        <TextBlock Text="版本" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE8FD;" Title="当前版本" Description="WinUI 前端 + Python 后台代理">
            <Button Content="检查更新" Click="OnCheckUpdateClick" />
        </controls:SettingCard>

        <TextBlock Text="项目" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE943;" Title="开源项目" Description="GitHub 仓库链接（占位，尚未发布）">
            <HyperlinkButton Content="github.com/…/ScreenLens" Click="OnProjectLinkClick" />
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE9D9;" Title="技术栈" Description="WinUI 3 · Windows App SDK · XAML 原生控件；OCR 本地 RapidOCR；翻译可选 Google 免费 / OpenAI 兼容">
            <HyperlinkButton Content="查看开发文档" Click="OnProjectLinkClick" />
        </controls:SettingCard>

        <TextBlock Text="声明" Style="{StaticResource SectionHeaderText}" />
        <Border Style="{StaticResource SettingCardBorderStyle}" Padding="16">
            <TextBlock Style="{StaticResource CardDescText}" TextWrapping="Wrap"
                       Text="ScreenLens 由 WinUI 前端 + Python 后台代理两部分组成，前端通过命名管道与代理通信。截图、识别文本、API Key 不会写入日志；翻译请求只发送识别到的文本，截图本身不会上传。" />
        </Border>

    </StackPanel>
</Page>
