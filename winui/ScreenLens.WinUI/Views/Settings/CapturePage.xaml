<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenLens.WinUI.Views.Settings.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenLens.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <StackPanel Style="{StaticResource SettingsPagePanel}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GlowWidthAction.(Grid.Row)" Value="0" />
                        <Setter Target="GlowWidthAction.(Grid.Column)" Value="1" />
                        <Setter Target="GlowWidthAction.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="GlowDepthAction.(Grid.Row)" Value="0" />
                        <Setter Target="GlowDepthAction.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GlowWidthAction.(Grid.Row)" Value="1" />
                        <Setter Target="GlowWidthAction.(Grid.Column)" Value="0" />
                        <Setter Target="GlowWidthAction.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="GlowDepthAction.(Grid.Row)" Value="1" />
                        <Setter Target="GlowDepthAction.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock Text="截图与选区" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="设置鼠标选区方式、背景遮罩与确认行为" Style="{StaticResource PageSubtitleText}" />

        <TextBlock Text="选区" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE8B6;" Title="鼠标左键选区" Description="按住左键拖动时使用的形状，默认自由圈选">
            <ComboBox SelectedIndex="{x:Bind Vm.LeftCaptureMode, Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="鼠标左键选区方式">
                <ComboBoxItem Content="矩形选区" />
                <ComboBoxItem Content="自由圈选" />
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE8B6;" Title="鼠标右键选区" Description="按住右键拖动时使用的形状，默认矩形选区">
            <ComboBox SelectedIndex="{x:Bind Vm.RightCaptureMode, Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="鼠标右键选区方式">
                <ComboBoxItem Content="矩形选区" />
                <ComboBoxItem Content="自由圈选" />
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE7EF;" Title="自由圈选外接矩形边框" Description="关闭后仅隐藏圈选区域的外接矩形边框，圈选轨迹始终显示；矩形模式不受影响">
            <ToggleSwitch IsOn="{x:Bind Vm.FreeformBorderEnabled, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="自由圈选外接矩形边框" />
        </controls:SettingCard>

        <controls:SettingCard x:Name="RainbowSettingsCard" Icon="&#xE790;" Title="彩虹圈选" Description="沿自由圈选轨迹显示柔和彩虹光带与暖色光头；关闭后显示普通圈选轨迹&#x0A;仅在关闭“自由圈选外接矩形边框”后可开启，暂停时保留以下偏好。">
            <ToggleSwitch x:Name="FreeformGlowSwitch"
                          IsOn="{x:Bind Vm.FreeformGlowActive, Mode=TwoWay}"
                          IsEnabled="{x:Bind Vm.CanEnableFreeformGlow, Mode=OneWay}"
                          OnContent="" OffContent="" AutomationProperties.Name="彩虹圈选光效" />
            <controls:SettingCard.DetailsContent>
                <StackPanel Spacing="16">
                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="轨迹宽度" Style="{StaticResource CardTitleText}" />
                            <TextBlock Text="默认 100%，可调节为 50%–200%" Style="{StaticResource CardDescText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="GlowWidthAction" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="FreeformGlowWidthSlider" Width="180" Minimum="50" Maximum="200" StepFrequency="10"
                                    IsEnabled="{x:Bind Vm.FreeformGlowActive, Mode=OneWay}"
                                    Value="{x:Bind Vm.FreeformGlowWidthPercent, Mode=TwoWay}"
                                    AutomationProperties.Name="彩虹圈选宽度百分比" />
                            <TextBlock Text="{x:Bind Vm.FreeformGlowWidthLabel, Mode=OneWay}" MinWidth="42" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="完成后光晕与阴影" Style="{StaticResource CardTitleText}" />
                            <TextBlock Text="松开鼠标后渐入柔和光晕、轻微阴影与细亮边；关闭后保留彩虹轨迹" Style="{StaticResource CardDescText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="GlowDepthAction" Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind Vm.FreeformGlowDepthEnabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind Vm.FreeformGlowActive, Mode=OneWay}"
                                      OnContent="" OffContent="" AutomationProperties.Name="彩虹圈选完成后光晕与阴影" />
                    </Grid>
                </StackPanel>
            </controls:SettingCard.DetailsContent>
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE790;" Title="选区背景黑色遮罩" Description="开启后压暗选区外的画面；关闭后保持截图原始亮度">
            <ToggleSwitch IsOn="{x:Bind Vm.CaptureDimMaskEnabled, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="选区背景黑色遮罩" />
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE8E5;" Title="选区后显示确认工具条" Description="开启：松开鼠标后显示确认 / 取消工具条；关闭：松开鼠标直接开始识别">
            <ToggleSwitch IsOn="{x:Bind Vm.ConfirmOnRelease, Mode=TwoWay}" OnContent="" OffContent="" />
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE74E;" Title="复制或保存后退出截图" Description="图像复制到剪贴板或保存成功后自动关闭截图工具条，默认开启">
            <ToggleSwitch IsOn="{x:Bind Vm.CloseCaptureAfterImageAction, Mode=TwoWay}" OnContent="" OffContent=""
                          AutomationProperties.Name="复制或保存图像成功后退出截图" />
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE75A;" Title="选区工具条" Description="截图时跟随选区显示的浮动工具条">
            <Button Content="了解工具条行为" Click="OnToolbarHelpClick" />
        </controls:SettingCard>

        <Border Style="{StaticResource SettingCardBorderStyle}" Padding="16">
            <StackPanel Spacing="4">
                <TextBlock Text="工具条行为说明" Style="{StaticResource CardTitleText}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 工具条仅在选区形成后出现，靠近选区下边缘（空间不足时自动上移）" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 左键 / 右键：按上方设置绘制自由圈选或矩形选区" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 宽度 / 高度：修改选区的像素尺寸；拖动手柄可移动工具条" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 取消：退出本次截图；确认：立即开始识别" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 键盘：Enter 确认，Esc 取消" />
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
