<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenLens.WinUI.Views.Settings.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenLens.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Style="{StaticResource SettingsPagePanel}">

        <TextBlock Text="截图与选区" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="控制屏幕截取时的选区行为（原型演示）" Style="{StaticResource PageSubtitleText}" />

        <TextBlock Text="选区" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE8B6;" Title="默认选区模式" Description="进入截图后首先使用的选区形状">
            <ComboBox SelectedIndex="{x:Bind Vm.DefaultCaptureMode, Mode=TwoWay}" MinWidth="160">
                <ComboBoxItem Content="矩形选区" />
                <ComboBoxItem Content="自由圈选" />
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE8E5;" Title="选区后显示确认工具条" Description="开启：松开鼠标后显示确认 / 取消工具条，点击确认才进入识别；关闭：松开鼠标直接开始识别（演示中直接打开结果预览）">
            <ToggleSwitch IsOn="{x:Bind Vm.ConfirmOnRelease, Mode=TwoWay}" OnContent="" OffContent="" />
        </controls:SettingCard>

        <controls:SettingCard Icon="&#xE75A;" Title="选区工具条" Description="截图时跟随选区显示的浮动工具条">
            <Button Content="了解工具条行为" Click="OnToolbarHelpClick" />
        </controls:SettingCard>

        <Border Style="{StaticResource SettingCardBorderStyle}" Padding="16">
            <StackPanel Spacing="4">
                <TextBlock Text="工具条行为说明" Style="{StaticResource CardTitleText}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 工具条仅在选区形成后出现，靠近选区下边缘（空间不足时自动上移）" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 矩形 / 自由圈选：切换本次截图的选区形状" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 放大镜：逐像素微调选区边界（尚未接入）" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 取消：退出本次截图；确认：立即开始识别" />
                <TextBlock Style="{StaticResource CardDescText}" Text="· 键盘：Enter 确认，Esc 取消，方向键微调选区位置" />
            </StackPanel>
        </Border>

        <TextBlock Text="演示" Style="{StaticResource SectionHeaderText}" />
        <controls:SettingCard Icon="&#xE722;" Title="截图选区演示" Description="在模拟桌面上体验选区遮罩、尺寸反馈与工具条（不截取真实屏幕）；是否显示确认工具条跟随上方开关">
            <Button Content="打开演示窗口" Style="{StaticResource AppAccentButtonStyle}" Click="OnOpenDemoClick" />
        </controls:SettingCard>

    </StackPanel>
</Page>
