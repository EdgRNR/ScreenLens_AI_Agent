<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenLens.WinUI.Views.Settings.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScreenLens.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ScreenLens.WinUI.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/HotkeyDialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Style="{StaticResource SettingsPagePanel}">

        <TextBlock Text="快捷键" Style="{StaticResource PageTitleText}" />

        <TextBlock Text="快捷键设置" Style="{StaticResource SectionHeaderText}" />

        <ItemsControl ItemsSource="{x:Bind Vm.Hotkeys}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:HotkeyEntry">
                    <controls:SettingCard
                        Icon="{x:Bind Icon}"
                        Title="{x:Bind Action}"
                        Description="{x:Bind Description}"
                        Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource AppBadgeBgBrush}" CornerRadius="4" Padding="10,5">
                                <TextBlock Text="{x:Bind Keys, Mode=OneWay}" FontFamily="Consolas" FontSize="13"
                                           Foreground="{ThemeResource AppBadgeFgBrush}" />
                            </Border>
                            <Button Content="编辑" Click="OnEditHotkeyClick" />
                        </StackPanel>
                    </controls:SettingCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="恢复默认快捷键" Click="OnResetHotkeysClick" Margin="0,8,0,0" />
    </StackPanel>
</Page>
