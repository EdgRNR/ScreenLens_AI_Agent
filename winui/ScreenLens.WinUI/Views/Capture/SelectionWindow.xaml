<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenLens.WinUI.Views.Capture.SelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 截图选区覆盖层：覆盖整个虚拟桌面，支持在任意显示器上选区 -->
    <Grid x:Name="Root" Background="Black" Opacity="0"
          KeyDown="OnRootKeyDown"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased">

        <Image x:Name="ShotImage" Stretch="Fill" />

        <!-- 单一偶奇填充遮罩，在选区矩形处挖空，避免多块矩形在高 DPI 下接缝/错位。 -->
        <Path x:Name="DimMask"
              Fill="#B2000000"
              IsHitTestVisible="False"
              Visibility="Collapsed" />

        <!-- 自由圈选轨迹；保持现有截图界面，只在默认模式为自由圈选时显示 -->
        <Polyline x:Name="FreeformLine"
                  Stroke="{ThemeResource ScreenLensAccentBrush}"
                  StrokeThickness="2"
                  IsHitTestVisible="False"
                  Visibility="Collapsed" />

        <!-- 每台显示器各自显示一份提示，避免提示条横跨屏幕接缝。 -->
        <Canvas x:Name="HintCanvas" IsHitTestVisible="False" />

        <!-- 选区边框 -->
        <Border x:Name="SelBorder"
                BorderBrush="{ThemeResource ScreenLensAccentBrush}"
                BorderThickness="1.5"
                Background="Transparent"
                Visibility="Collapsed" />

        <!-- 选区完成后显示的尺寸编辑与操作工具条 -->
        <Border x:Name="Toolbar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                RequestedTheme="Light"
                Background="#FFF4F5F7"
                CornerRadius="8"
                Padding="6"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Border x:Name="ToolbarDragHandle"
                        Background="#FFE7E9ED"
                        CornerRadius="5"
                        Padding="8,7"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="拖动以移动工具条"
                        PointerPressed="OnToolbarDragPressed"
                        PointerMoved="OnToolbarDragMoved"
                        PointerReleased="OnToolbarDragReleased"
                        PointerCanceled="OnToolbarDragCanceled">
                    <Canvas Width="18" Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Ellipse Width="3" Height="3" Fill="#FF555B64" Canvas.Left="2.5" Canvas.Top="2.5" />
                        <Ellipse Width="3" Height="3" Fill="#FF555B64" Canvas.Left="7.5" Canvas.Top="2.5" />
                        <Ellipse Width="3" Height="3" Fill="#FF555B64" Canvas.Left="12.5" Canvas.Top="2.5" />
                        <Ellipse Width="3" Height="3" Fill="#FF555B64" Canvas.Left="2.5" Canvas.Top="7.5" />
                        <Ellipse Width="3" Height="3" Fill="#FF555B64" Canvas.Left="7.5" Canvas.Top="7.5" />
                        <Ellipse Width="3" Height="3" Fill="#FF555B64" Canvas.Left="12.5" Canvas.Top="7.5" />
                        <Ellipse Width="3" Height="3" Fill="#FF555B64" Canvas.Left="2.5" Canvas.Top="12.5" />
                        <Ellipse Width="3" Height="3" Fill="#FF555B64" Canvas.Left="7.5" Canvas.Top="12.5" />
                        <Ellipse Width="3" Height="3" Fill="#FF555B64" Canvas.Left="12.5" Canvas.Top="12.5" />
                    </Canvas>
                </Border>
                <TextBox x:Name="SelectionWidthBox"
                         Width="70" MinWidth="54" Height="36"
                         Padding="0"
                         VerticalContentAlignment="Top"
                         FontFamily="Consolas"
                         InputScope="Number"
                         TextChanged="OnDimensionTextChanged"
                         LostFocus="OnDimensionLostFocus"
                         KeyDown="OnDimensionKeyDown"
                         ToolTipService.ToolTip="选区宽度（像素）" />
                <TextBlock Text="×" VerticalAlignment="Center"
                           Foreground="#FF555B64" />
                <TextBox x:Name="SelectionHeightBox"
                         Width="70" MinWidth="54" Height="36"
                         Padding="0"
                         VerticalContentAlignment="Top"
                         FontFamily="Consolas"
                         InputScope="Number"
                         TextChanged="OnDimensionTextChanged"
                         LostFocus="OnDimensionLostFocus"
                         KeyDown="OnDimensionKeyDown"
                         ToolTipService.ToolTip="选区高度（像素）" />
                <TextBlock Text="px" VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           Foreground="#FF737780" />
                <Button Background="Transparent" Foreground="#FF202124"
                        BorderThickness="0" Padding="10,8"
                        Click="OnConfirmClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Accept" />
                        <TextBlock Text="识别 (Enter)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Background="Transparent" Foreground="#FF202124"
                        BorderThickness="0" Padding="10,8"
                        Click="OnReselectClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="重新选择" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Background="Transparent" Foreground="#FF202124"
                        BorderThickness="0" Padding="10,8"
                        Click="OnCancelClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Cancel" />
                        <TextBlock Text="取消 (Esc)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 错误提示 -->
        <InfoBar x:Name="ErrorBar"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,80,0,0"
                 MaxWidth="520"
                 IsClosable="True" />

        <!-- 识别中覆盖层 -->
        <Grid x:Name="BusyOverlay"
              Background="#88000000"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <ProgressRing IsActive="True" Width="44" Height="44" />
                <TextBlock x:Name="BusyText" Text="正在识别…"
                           Foreground="#FFF2F3F7" FontSize="14"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
