<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenLens.WinUI.Views.Capture.SelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 截图选区覆盖层：只覆盖热键触发时鼠标所在的显示器 -->
    <Grid x:Name="Root" Background="Black"
          KeyDown="OnRootKeyDown"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased">

        <Image x:Name="ShotImage" Stretch="Fill" />

        <!-- 挖洞遮罩（按下时选区之外变暗） -->
        <Rectangle x:Name="DimTop" Fill="#B2000000" Visibility="Collapsed" />
        <Rectangle x:Name="DimBottom" Fill="#B2000000" Visibility="Collapsed" />
        <Rectangle x:Name="DimLeft" Fill="#B2000000" Visibility="Collapsed" />
        <Rectangle x:Name="DimRight" Fill="#B2000000" Visibility="Collapsed" />

        <!-- 自由圈选轨迹；保持现有截图界面，只在默认模式为自由圈选时显示 -->
        <Polyline x:Name="FreeformLine"
                  Stroke="{ThemeResource ScreenLensAccentBrush}"
                  StrokeThickness="2"
                  IsHitTestVisible="False"
                  Visibility="Collapsed" />

        <!-- 选区边框 -->
        <Border x:Name="SelBorder"
                BorderBrush="{ThemeResource ScreenLensAccentBrush}"
                BorderThickness="1.5"
                Background="Transparent"
                Visibility="Collapsed" />

        <!-- 尺寸标签 -->
        <Border x:Name="SizeTag"
                Background="#CC1F1F26"
                CornerRadius="4"
                Padding="8,3"
                Visibility="Collapsed"
                VerticalAlignment="Top"
                HorizontalAlignment="Left">
            <TextBlock x:Name="SizeText" FontSize="12"
                       Foreground="#FFF2F3F7"
                       FontFamily="Consolas" />
        </Border>

        <!-- 确认工具条 -->
        <CommandBar x:Name="Toolbar"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,48"
                    Background="#F21F1F26"
                    CornerRadius="8"
                    Visibility="Collapsed">
            <AppBarButton Label="识别（Enter）" Icon="Accept"
                          Click="OnConfirmClick" />
            <AppBarButton Label="重新选择" Icon="Refresh"
                          Click="OnReselectClick" />
            <AppBarButton Label="取消（Esc）" Icon="Cancel"
                          Click="OnCancelClick" />
        </CommandBar>

        <!-- 提示条 -->
        <Border x:Name="HintBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Background="#CC1F1F26"
                CornerRadius="16"
                Padding="16,7">
            <TextBlock x:Name="HintText" Text="拖拽选择识别区域 · Enter 确认 · Esc 取消"
                       FontSize="13" Foreground="#FFF2F3F7" />
        </Border>

        <!-- 错误提示 -->
        <InfoBar x:Name="ErrorBar"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,80,0,0"
                 MaxWidth="520"
                 IsClosable="True" />

        <!-- 识别中覆盖层 -->
        <Grid x:Name="BusyOverlay"
              Background="#88000000"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <ProgressRing IsActive="True" Width="44" Height="44" />
                <TextBlock x:Name="BusyText" Text="正在识别…"
                           Foreground="#FFF2F3F7" FontSize="14"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
