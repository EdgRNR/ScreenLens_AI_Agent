<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenLens.WinUI.Views.Preview.CaptureDemoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="截图选区演示 — 模拟桌面（ScreenLens）">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyDown="OnRootKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- ① 模拟桌面（虚构内容，不截取真实屏幕） -->
        <Grid IsHitTestVisible="False">
            <!-- 渐变壁纸 -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#20304A" Offset="0" />
                        <GradientStop Color="#1B2438" Offset="0.55" />
                        <GradientStop Color="#15243A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 装饰光斑 -->
            <Ellipse Width="420" Height="420" Fill="#223D9BFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-120,0,0" />
            <Ellipse Width="300" Height="300" Fill="#1A7C6FF0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-60,-80" />

            <!-- 假窗口 1：文件管理器 -->
            <Border Width="540" Height="340" CornerRadius="8" Background="#F2F2F2" Margin="90,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <Border Background="#E6E6E6" CornerRadius="8,8,0,0" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#444444" />
                            <TextBlock Text="文档" FontSize="12" Foreground="#333333" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="16,14" Spacing="8">
                        <Rectangle Height="56" RadiusX="4" RadiusY="4" Fill="#DDDDDD" />
                        <Rectangle Height="56" RadiusX="4" RadiusY="4" Fill="#D4D4D4" />
                        <Rectangle Height="56" RadiusX="4" RadiusY="4" Fill="#DCDCDC" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 假窗口 2：记事本（示例识别文本的视觉来源） -->
            <Border Width="400" Height="300" CornerRadius="8" Background="#FAFAFA" Margin="660,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <Border Background="#EDEDED" CornerRadius="8,8,0,0" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE70B;" FontSize="14" Foreground="#444444" />
                            <TextBlock Text="说明.txt - 记事本" FontSize="12" Foreground="#333333" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="16,12" Spacing="10">
                        <TextBlock Text="ScreenLens —— 屏幕翻译小工具" FontSize="14" Foreground="#222222" />
                        <TextBlock Text="快捷键：Ctrl + Alt + A 启动截图翻译" FontSize="14" Foreground="#222222" />
                        <TextBlock Text="Esc 取消本次截图" FontSize="14" Foreground="#222222" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 任务栏 -->
            <Border Height="48" VerticalAlignment="Bottom" Background="#CC161616">
                <StackPanel Orientation="Horizontal" Spacing="24" Margin="20,0" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE700;" Foreground="#AAAAAA" />
                    <FontIcon Glyph="&#xE722;" Foreground="#AAAAAA" />
                    <FontIcon Glyph="&#xE77B;" Foreground="#AAAAAA" />
                    <FontIcon Glyph="&#xE713;" Foreground="#AAAAAA" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ② 半透明遮罩（四块矩形对选区“挖洞”） -->
        <Canvas x:Name="MaskCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="MaskTop" Fill="{ThemeResource AppMaskBrush}" />
            <Rectangle x:Name="MaskBottom" Fill="{ThemeResource AppMaskBrush}" />
            <Rectangle x:Name="MaskLeft" Fill="{ThemeResource AppMaskBrush}" />
            <Rectangle x:Name="MaskRight" Fill="{ThemeResource AppMaskBrush}" />
        </Canvas>

        <!-- ③ 选区装饰层：矩形边框 + 自由路径 + 尺寸标签 -->
        <Canvas x:Name="SelectionLayer" IsHitTestVisible="False">
            <Border x:Name="SelBorder" Style="{StaticResource SelectionBorder}" />
            <Polyline x:Name="FreePath" StrokeThickness="2" StrokeDashArray="4 2" Visibility="Collapsed"
                      Stroke="{ThemeResource ScreenLensAccentBrush}" />
            <Border x:Name="SizeBadge" Background="{ThemeResource AppBadgeBgBrush}" CornerRadius="4" Padding="10,4">
                <TextBlock x:Name="SizeText" FontFamily="Consolas" FontSize="12"
                           Foreground="{ThemeResource AppBadgeFgBrush}" />
            </Border>
        </Canvas>

        <!-- ④ 指针交互捕获层（透明，位于工具条之下，可聚焦以接收键盘） -->
        <Grid x:Name="HitLayer" Background="Transparent" IsTabStop="True" TabIndex="0"
              PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved"
              PointerReleased="OnPointerReleased" PointerCanceled="OnPointerReleased" />

        <!-- ⑤ 浮动工具条 -->
        <Canvas x:Name="OverlayCanvas">
            <Border x:Name="Toolbar" CornerRadius="8" Padding="6" Visibility="Collapsed"
                    Background="{ThemeResource AppBadgeBgBrush}" BorderThickness="1"
                    BorderBrush="{ThemeResource AppCardBorderBrush}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <RadioButton x:Name="ModeRect" GroupName="DemoMode" Content="矩形" IsChecked="True" Checked="OnModeChanged" MinWidth="0" />
                    <RadioButton x:Name="ModeFree" GroupName="DemoMode" Content="自由圈选" Checked="OnModeChanged" MinWidth="0" />
                    <AppBarSeparator />
                    <Button Click="OnMagnifierClick" ToolTipService.ToolTip="放大镜（演示）">
                        <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                    </Button>
                    <AppBarSeparator />
                    <Button Content="取消" Click="OnCancelClick" />
                    <Button Content="确认" Style="{StaticResource AppAccentButtonStyle}" Click="OnConfirmClick" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- ⑥ 底部提示条 -->
        <InfoBar x:Name="ModeHint" IsOpen="False" IsClosable="True" Severity="Informational"
                 Title="演示说明" Message="" Margin="16" VerticalAlignment="Bottom" />
    </Grid>
</Window>
