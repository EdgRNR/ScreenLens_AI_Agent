<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenLens.WinUI.Views.Result.ResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Padding="16,12,16,14" RowSpacing="10"
          KeyDown="OnRootKeyDown"
          Background="{ThemeResource AppWindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="TranslationRow" Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 内容标题兼作拖动区域；窗口操作按钮不进入拖动区域。 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="HeaderDragArea" Background="Transparent">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A5;" FontSize="15"
                              Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="识别结果" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="MetaText" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="MinimizeBtn" Click="OnMinimizeClick"
                        Width="32" MinWidth="32" Height="32" Padding="0"
                        ToolTipService.ToolTip="最小化" AutomationProperties.Name="最小化">
                    <FontIcon Glyph="&#xE921;" FontSize="13" />
                </Button>
                <Button x:Name="MaximizeBtn" Click="OnMaximizeClick"
                        Width="32" MinWidth="32" Height="32" Padding="0"
                        ToolTipService.ToolTip="最大化" AutomationProperties.Name="最大化">
                    <FontIcon x:Name="MaximizeIcon" Glyph="&#xE922;" FontSize="13" />
                </Button>
                <Button x:Name="CloseBtn" Click="OnCloseClick"
                        Width="32" MinWidth="32" Height="32" Padding="0"
                        ToolTipService.ToolTip="关闭（Esc）" AutomationProperties.Name="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 原文 -->
        <TextBox x:Name="OcrText" Grid.Row="1"
                 IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PlaceholderText="（选区内未识别到文字）" />

        <!-- 译文 -->
        <Grid x:Name="TranslatePanel" Grid.Row="2" RowSpacing="6"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="译文" FontSize="12"
                       Foreground="{ThemeResource AppTextTertiaryBrush}" />
            <TextBox x:Name="TranslatedText" Grid.Row="1" IsReadOnly="True"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontSize="14" />
        </Grid>

        <!-- 状态 / 操作 -->
        <InfoBar x:Name="StatusInfo" Grid.Row="3" IsClosable="False" />
        <Grid x:Name="ActionButtons" Grid.Row="4" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="TranslationActions" Grid.ColumnSpan="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TranslateBtn" Click="OnTranslateClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="翻译" MinWidth="0" Padding="8,5"
                        HorizontalAlignment="Stretch" />
                <!-- WinUI reserves 38 DIP on the right for the chevron.
                     Mirror that space on the left to center the label in the full control. -->
                <ComboBox x:Name="TargetLanguageBox" Grid.Column="1" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Padding="50,5,12,5" VerticalAlignment="Stretch"
                          AutomationProperties.Name="本次翻译目标语言"
                          ToolTipService.ToolTip="本次翻译目标语言，不修改设置">
                    <ComboBoxItem Content="简体中文" Tag="zh" />
                    <ComboBoxItem Content="英语" Tag="en" />
                    <ComboBoxItem Content="日语" Tag="ja" />
                </ComboBox>
            </Grid>
            <Button x:Name="RecaptureBtn" Grid.Row="1" Click="OnRecaptureClick"
                    Content="重新截图" MinWidth="0" HorizontalAlignment="Stretch" />
            <Button x:Name="CopyBtn" Grid.Row="1" Grid.Column="1" Click="OnCopyClick" Content="复制"
                    MinWidth="0" HorizontalAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
