<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenLens.WinUI.Views.Result.ResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Padding="16,12,16,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8A5;" FontSize="15"
                          Foreground="{ThemeResource AppTextSecondaryBrush}" />
                <TextBlock Text="识别结果" FontSize="15" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="MetaText" FontSize="12"
                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="8,1,0,0" />
            </StackPanel>
            <Button x:Name="CloseBtn" Click="OnCloseClick"
                    HorizontalAlignment="Right"
                    Content="&#xE711;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="13" Width="32" Height="32" Padding="0"
                    ToolTipService.ToolTip="关闭（Esc）" />
        </Grid>

        <!-- 原文 -->
        <TextBox x:Name="OcrText" Grid.Row="1"
                 IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PlaceholderText="（选区内未识别到文字）" />

        <!-- 译文 -->
        <StackPanel x:Name="TranslatePanel" Grid.Row="2" Spacing="6"
                    Visibility="Collapsed">
            <TextBlock Text="译文" FontSize="12"
                       Foreground="{ThemeResource AppTextTertiaryBrush}" />
            <TextBox x:Name="TranslatedText" IsReadOnly="True"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontSize="14" />
        </StackPanel>

        <!-- 状态 / 操作 -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <InfoBar x:Name="StatusInfo" IsClosable="False" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right">
                <Button x:Name="TranslateBtn" Click="OnTranslateClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="翻译" MinWidth="88" />
                <Button Click="OnRecaptureClick" Content="重新截图"
                        MinWidth="88" />
                <Button x:Name="CopyBtn" Click="OnCopyClick" Content="复制"
                        MinWidth="88" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
