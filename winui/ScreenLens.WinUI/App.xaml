<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ScreenLens.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenLens.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/ThemeResources.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SettingsIconGeometryConverter xmlns="using:ScreenLens.WinUI.Controls" x:Key="SettingsIconGeometryConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
